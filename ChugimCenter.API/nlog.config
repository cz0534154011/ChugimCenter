<?xml version="1.0" encoding="utf-8" ?>
<!--
  הגדרות NLog: לאן נכתב הלוג ובאיזה מבנה.
  אילו רמות נכתבות נקבע ב-appsettings.json (Logging:LogLevel): Information כברירת מחדל, ו-Debug בפיתוח.
  internalLogFile: הלוג הפנימי של NLog עצמו, רק אם יש בעיה בהגדרות.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <variables>
    <!-- מבנה שורה: זמן | רמה | CorrelationId | מקור | הודעה (ופירוט החריגה, אם יש) -->
    <variable name="lineLayout"
              value="${longdate}|${level:uppercase=true:padding=-5}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />
  </variables>

  <targets>
    <!-- מסוף: מוצג ב-Visual Studio, וב-Render הוא הלוג שרואים בענן -->
    <target xsi:type="Console" name="console" layout="${lineLayout}" />

    <!-- קובץ יומי ליד קבצי ההרצה (bin), שבעה קבצים אחרונים נשמרים. *.log מסונן ב-.gitignore -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/chugim-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8"
            maxArchiveFiles="7" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="console,file" />
  </rules>
</nlog>
